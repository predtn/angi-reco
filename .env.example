# Local development only. Copy to .env: cp .env.example .env
ENVIRONMENT=development

# Database of angi-backend's docker compose; role angi_reco owns schema recommendation.
DATABASE_URL=postgresql://angi_reco:reco_dev@localhost:5432/angi

# Shared with the backend (user secret Recommendation:ApiKey); at least 32 characters.
RECO_API_KEY=dev-only-reco-api-key-change-me-0001

# LLM that generates dish vectors. Get the shared dev key from the team; never commit it.
LLM_API_KEY=

LOG_LEVEL=INFO
